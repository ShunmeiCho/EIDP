# Venus Linux/Web deployment. Keep every runtime path under /home/junming/EIDP.
EIDP_APP_ROOT=/home/junming/EIDP
EIDP_DATA_DIR=/home/junming/EIDP/data
EIDP_DATABASE_URL=sqlite:////home/junming/EIDP/data/eidp.sqlite3
PLAYWRIGHT_BROWSERS_PATH=/home/junming/EIDP/.cache/ms-playwright
EIDP_LOG_LEVEL=INFO

# Japanese era aliases used only for UI labels and search tokens. The data
# model stores western fiscal years such as 2026 / 2027.
EIDP_FISCAL_ERA_ENABLED=true
EIDP_FISCAL_ERA_NAME=令和
EIDP_FISCAL_ERA_ROMANIZED=reiwa
EIDP_FISCAL_ERA_INITIAL=r
EIDP_FISCAL_ERA_START_YEAR=2019

# Optional confidence threshold tuning.
# EIDP_CONFIDENCE_AUTO=0.85
# EIDP_CONFIDENCE_REVIEW=0.70
# EIDP_CONFIDENCE_REJECT=0.50

# Optional OCR runtime. Prefer the project-local path or a server PATH install.
EIDP_OCR_AUTO_ENABLE=auto
EIDP_OCR_MIN_CPUS=2
EIDP_OCR_MIN_FREE_RAM_MB=4096
# EIDP_TESSERACT_BIN=/home/junming/EIDP/ocr/tesseract/bin/tesseract
# EIDP_OCR_PROVIDER=tesseract
# EIDP_OCR_DEVICE=cpu

# Search API (choose one; DuckDuckGo needs no key).
EIDP_SEARCH_PROVIDER=duckduckgo
EIDP_URL_SEARCH_AUTO_ENABLE=auto
EIDP_URL_SEARCH_BATCH_SIZE=200
# Optional school URL completion. Scrapling/Playwright stays inside the project.
EIDP_SCHOOL_URL_CRAWL_AUTO_ENABLE=auto
EIDP_SCHOOL_URL_CRAWL_BATCH_SIZE=25
EIDP_SCHOOL_URL_CRAWL_FETCH_MODE=static
# EIDP_SEARCH_PROVIDER=serper
# EIDP_SERPER_API_KEY=
# EIDP_SEARCH_PROVIDER=brave
# EIDP_BRAVE_API_KEY=
# EIDP_SEARCH_PROVIDER=google
# EIDP_GOOGLE_API_KEY=
# EIDP_GOOGLE_CX=

# Optional external command provider for administrator-only candidate research.
# It must emit JSON and must not directly write business data.
# EIDP_SEARCH_PROVIDER=external
# EIDP_EXTERNAL_SEARCH_COMMAND=/home/junming/EIDP/tools/search-wrapper
# EIDP_EXTERNAL_SEARCH_TIMEOUT_SECONDS=30

# Optional Firecrawl API for corporation-root expansion.
EIDP_FIRECRAWL_API_KEY=
