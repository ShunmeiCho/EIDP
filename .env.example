# Windows operator default. If EIDP_DATABASE_URL is omitted, EIDP stores the
# SQLite database at EIDP_DATA_DIR/eidp.sqlite3.
EIDP_LOG_LEVEL=INFO
EIDP_DATA_DIR=C:/EIDP/data

# Optional: pin the operational target year manually. Leave commented for
# normal annual operation; EIDP will use the current Japanese fiscal year
# automatically (April-March boundary).
# EIDP_TARGET_FISCAL_YEAR=2026

# Optional: Japanese era aliases used only for UI labels and government/school
# page search tokens. Keep Reiwa unless the official naming changes; the core
# data model always stores western fiscal years such as 2026 / 2027.
EIDP_FISCAL_ERA_ENABLED=true
EIDP_FISCAL_ERA_NAME=令和
EIDP_FISCAL_ERA_ROMANIZED=reiwa
EIDP_FISCAL_ERA_INITIAL=r
EIDP_FISCAL_ERA_START_YEAR=2019

# Developer Postgres example (do not use on the operator PC):
# EIDP_DATABASE_URL=postgresql://eidp:eidp@127.0.0.1:5432/eidp

# Optional confidence threshold tuning:
# EIDP_CONFIDENCE_AUTO=0.85
# EIDP_CONFIDENCE_REVIEW=0.70
# EIDP_CONFIDENCE_REJECT=0.50

# Optional OCR override. Normal Windows add-on detection uses
# C:/EIDP/ocr-addon/tesseract/tesseract.exe.
EIDP_OCR_AUTO_ENABLE=auto
EIDP_OCR_MIN_CPUS=2
EIDP_OCR_MIN_FREE_RAM_MB=4096
# EIDP_TESSERACT_BIN=C:/EIDP/ocr-addon/tesseract/tesseract.exe
# EIDP_OCR_PROVIDER=tesseract
# EIDP_OCR_DEVICE=cpu

# Search API (choose one, default: duckduckgo — no key needed)
EIDP_SEARCH_PROVIDER=duckduckgo
EIDP_URL_SEARCH_AUTO_ENABLE=auto
EIDP_URL_SEARCH_BATCH_SIZE=200
# Optional school URL completion for schools still missing SchoolSite rows.
# Requires the Scrapling/Playwright add-on; auto runs only when prerequisites are ready.
EIDP_SCHOOL_URL_CRAWL_AUTO_ENABLE=auto
EIDP_SCHOOL_URL_CRAWL_BATCH_SIZE=25
EIDP_SCHOOL_URL_CRAWL_FETCH_MODE=static
# EIDP_SEARCH_PROVIDER=serper
# EIDP_SERPER_API_KEY=          # free 2,500/month at serper.dev
# EIDP_SEARCH_PROVIDER=brave
# EIDP_BRAVE_API_KEY=
# EIDP_SEARCH_PROVIDER=google
# EIDP_GOOGLE_API_KEY=
# EIDP_GOOGLE_CX=

# Firecrawl API (for corporation root URL expansion)
# Free: 500 credits/month at firecrawl.dev
# Only needed for initial URL discovery, not for weekly operations
EIDP_FIRECRAWL_API_KEY=
