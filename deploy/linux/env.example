# EIDP Linux/Web MVP environment template.
# Copy to the selected server's private environment file after owner/PI/ICT
# selects the host. Do not commit a filled environment file.

# No concrete Linux server has been selected yet.
EIDP_ENV=internal-mvp

# Application and storage roots. Replace with approved selected-server paths.
EIDP_HOME=/srv/eidp/app
EIDP_DATA_DIR=/srv/eidp/data
EIDP_UPLOAD_DIR=/srv/eidp/uploads
EIDP_REPORT_DIR=/srv/eidp/reports
EIDP_LOG_DIR=/srv/eidp/logs
EIDP_BACKUP_DIR=/srv/eidp/backups

# Streamlit remains localhost-bound for the MVP. LAN access should come through
# an approved internal reverse proxy rather than binding Streamlit to 0.0.0.0.
EIDP_WEB_BIND=127.0.0.1
EIDP_WEB_PORT=8502

# Public-facing only inside the approved internal network.
# Examples:
#   http://<linux-server-ip>:<port>
#   http://eidp.internal.example
EIDP_INTERNAL_BASE_URL=
EIDP_ALLOWED_CIDR=

# Optional reverse proxy settings. Fill only after a server is selected.
EIDP_REVERSE_PROXY_HOST=
EIDP_REVERSE_PROXY_PORT=

# Formal multi-user operation still requires authentication and audit identity.
# This MVP template does not implement auth.
EIDP_AUTH_MODE=not_implemented
