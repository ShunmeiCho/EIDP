# EIDP Linux/Web environment template for venus.
# Copy to a private .env under /home/junming/EIDP. Never commit secrets.

EIDP_ENV=internal-mvp

# Authorized deployment boundary. All runtime files remain below this root.
EIDP_APP_ROOT=/home/junming/EIDP
EIDP_DATA_DIR=/home/junming/EIDP/data
EIDP_DATABASE_URL=sqlite:////home/junming/EIDP/data/eidp.sqlite3
PLAYWRIGHT_BROWSERS_PATH=/home/junming/EIDP/.cache/ms-playwright

# Streamlit remains fixed to 127.0.0.1. LAN access must come through an approved
# internal reverse proxy; bind address is intentionally not configurable.
EIDP_WEB_PORT=8502
EIDP_WEB_BASE_URL_PATH=
EIDP_WEB_MAX_UPLOAD_MB=200

# Public-facing only inside the approved internal network.
# Examples:
#   http://<linux-server-ip>:<port>
#   http://eidp.internal.example
# The URL path must match EIDP_WEB_BASE_URL_PATH after trailing-slash normalization.
EIDP_INTERNAL_BASE_URL=
EIDP_ALLOWED_CIDR=

# Formal multi-user operation still requires authentication and audit identity.
# This MVP template does not implement auth.
EIDP_AUTH_MODE=not_implemented
