[Unit]
Description=EIDP weekly R8 rediscovery and ingest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=junming
WorkingDirectory=/home/junming/workspace/EIDP
EnvironmentFile=-/home/junming/workspace/EIDP/.env
Environment=PATH=/home/junming/workspace/EIDP/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/junming/workspace/EIDP/src
Environment=VIRTUAL_ENV=/home/junming/workspace/EIDP/.venv
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
ExecStartPre=/home/junming/workspace/EIDP/.venv/bin/python -c "import sys, eidp; assert sys.prefix == '/home/junming/workspace/EIDP/.venv', f'venv isolation broken: {sys.prefix}'; print(f'venv ok: {sys.prefix}, eidp from {eidp.__file__}')"
ExecStart=/home/junming/workspace/EIDP/.venv/bin/python scripts/run_r8_rediscovery_weekly.py --methods prefecture_aggregator seed_csv corporation_pattern operator_manual scrapling_stealth --current-fy 2026 --batch-size 250 --ingest-batch-size 500 --rate-limit 1.5
TimeoutStartSec=6h
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
